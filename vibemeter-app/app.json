{
  "expo": {
    "name": "ViibeMeter",
    "slug": "vibemeter",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leogerasimov.vibemeter",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ViibeMeter analyses short sound clips on your phone to score the vibe. Clips are deleted right away; no audio is stored or uploaded.",
        "NSLocationWhenInUseUsageDescription": "ViibeMeter uses your location to detect when you arrive at and leave venues.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ViibeMeter tracks your location in the background to measure how long you stay at a venue.",
        "NSBluetoothAlwaysUsageDescription": "ViibeMeter scans for nearby Bluetooth devices to estimate crowd density. No device identities are stored.",
        "NSMotionUsageDescription": "ViibeMeter measures how much you move and whether it matches the beat. Only summary values are stored.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "audio",
          "bluetooth-central",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.vibemeter.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ViibeMeter tracks your location in the background to measure how long you stay at a venue."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00FF88"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": false
        }
      ]
    ],
    "scheme": "vibemeter",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa405677-786e-4053-b25a-1ab94d1ef465"
      }
    },
    "owner": "stoicslav"
  }
}